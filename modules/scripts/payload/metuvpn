export DEV_ENV='/home/jaysh/dev'
source "${DEV_ENV}/lib/log" && export -f logp
source "${DEV_ENV}/lib/ansi-escapes"

# blocking quickfix, has to be switched to the one below after 3.0.5-{1,2} which have `--background`
# disconnect by `<C-c>` (aka `^C`), blocking
main() {
    local username server opts progname err
    progname='METUVPN'
    username='e267561'
    server='https://duvar.metu.edu.tr'
    # opts='--passwd-on-stdin -v'
    opts='--passwd-on-stdin -q'
    # opts='--passwd-on-stdin'
    # word splitting is intentional in `$opts`, safe to ignore SC2086
    logp "$progname" \
        "${FG_L_BLUE}[INFO] Starting connection...${COLOR_RESET}" >&2
    logp "$progname" \
        "${FG_L_BLUE}[INFO] Don't forget to disconnect on ProtonVPN in Librewolf and nmtui.${COLOR_RESET}" >&2
    pass metu | sudo gpclient connect -u "$username" $opts -- "$server"
    err=$?
    if (( err != 0 )); then
        logp "$progname" \
            "${FG_L_RED}[ERROR] Connection failed for some reason.${COLOR_RESET} [$err]"
    fi
}

